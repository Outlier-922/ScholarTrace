  "claims": [
    {
      "claim_id": "s0c0",
      "section": "研究背景",
      "text": "Transformer 架构完全基于注意力机制，摒弃了循环和卷积结构，并在机器翻译任务上表现出更优的质量和更高的并行性。",
      "evidence_ids": [
        "ev_9a96c89ea629518bb9a7"
      ],
      "status": "source_checked",
      "kind": "paper_fact",
      "quotes": [
        {
          "evidence_id": "ev_9a96c89ea629518bb9a7",
          "quote": "We propose a new simple network architecture, the Transformer,\nbased solely on attention mechanisms, dispensing with recurrence and convolutions\nentirely.",
          "model_quote": "We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.",
          "match": "normalized_pdf_text",
          "start": 238,
          "end": 392
        }
      ],
      "semantic_verified": false
    },
    {
      "claim_id": "s0c1",
      "section": "研究背景",
      "text": "Transformer 的编码器和解码器均由堆叠的自注意力层和逐点全连接层构成。",
      "evidence_ids": [
        "ev_6c63fcc4b21224dfc700"
      ],
      "status": "source_checked",
      "kind": "paper_fact",
      "quotes": [
        {
          "evidence_id": "ev_6c63fcc4b21224dfc700",
          "quote": "The Transformer follows this overall architecture using stacked self-attention and point-wise, fully\nconnected layers for both the encoder and decoder",
          "model_quote": "The Transformer follows this overall architecture using stacked self-attention and point-wise, fully connected layers for both the encoder and decoder",
          "match": "normalized_pdf_text",
          "start": 0,
          "end": 150
        }
      ],
      "semantic_verified": false
    },
    {
      "claim_id": "s1c0",
      "section": "方法与路线",
      "text": "在 BERT 的术语中，仅使用左上下文的 Transformer 版本被称为“Transformer 解码器”，可用于文本生成；而双向版本则被称为“Transformer 编码器”。",
      "evidence_ids": [
        "ev_c8a196f7d20cc6d78e87"
      ],
      "status": "source_checked",
      "kind": "paper_fact",
      "quotes": [
        {
          "evidence_id": "ev_c8a196f7d20cc6d78e87",
          "quote": "former is often referred to as a “Transformer encoder” while\nthe left-context-only version is referred to as a “Transformer\ndecoder” since it can be used for text generation.",
          "model_quote": "former is often referred to as a “Transformer encoder” while the left-context-only version is referred to as a “Transformer decoder” since it can be used for text generation.",
          "match": "normalized_pdf_text",
          "start": 0,
          "end": 174
        }
      ],
      "semantic_verified": false
    },
    {
      "claim_id": "s2c0",
      "section": "局限与边界",
      "text": "BERT 的预训练依赖掩码语言模型，需要随机掩码输入 token 并预测其原始 id，这一目标本身引入了训练与微调之间的不一致性，但原文未进一步讨论该局限。",
      "evidence_ids": [
