# Copy this file to .env. Never commit real keys.
SCHOLARTRACE_DATA_DIR=./data
SCHOLARTRACE_MAX_UPLOAD_MB=100
SCHOLARTRACE_PARSE_WORKERS=2
SCHOLARTRACE_ENABLE_OCR=false
SCHOLARTRACE_ENABLE_TABLES=false
SCHOLARTRACE_ENABLE_DENSE=false
SCHOLARTRACE_MAX_INLINE_EMBED_CHUNKS=384
SCHOLARTRACE_TRANSLATION_MAX_BLOCKS=300

# Optional: an OpenAI-compatible chat completions service.
# LLM_BASE_URL should include the API prefix, for example https://provider.example/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DeepSeek example (see docs/MODEL_SETUP.md):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# Prepare local OCR/embedding models explicitly before enabling them.
# This remains a local single-user development build; public authentication is pending.
