# Copy this file to .env. Never commit real keys.
SCHOLARTRACE_DATA_DIR=./data
SCHOLARTRACE_MAX_UPLOAD_MB=100
SCHOLARTRACE_PARSE_WORKERS=2

# Optional: an OpenAI-compatible chat completions service.
# LLM_BASE_URL should include the API prefix, for example https://provider.example/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Stage 1 is a local single-user development build.
# Authentication, OCR, semantic embeddings and production queues are pending.
